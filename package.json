{
  "name": "megagym-fitness",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Site web de Megagym Fitness (B'ssadi Galleries, Bonamoussadi, Douala) — React, Tailwind CSS et Node.js (Express).",
  "scripts": {
    "dev": "concurrently -n api,web -c yellow,white \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "node --env-file-if-exists=.env --watch server/index.js --port=5050",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "preview": "npm run build && npm run start",
    "images": "node scripts/optimize-images.js"
  },
  "dependencies": {
    "express": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4"
  }
}
